{
  "name": "dctlive",
  "version": "0.1.3",
  "description": "WebGL implementation of JPEG-like DCT with real-time controls",
  "author": "geikha",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/geikha/dctlive.git"
  },
  "main": "dist/dctlive.js",
  "module": "dist/dctlive.esm.js",
  "exports": {
    ".": {
      "import": "./dist/dctlive.esm.js",
      "require": "./dist/dctlive.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs -w",
    "serve": "npx serve"
  },
  "keywords": [
    "dct",
    "webgl",
    "jpeg",
    "glsl",
    "image-processing"
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "gl": "^8.1.6",
    "glslify": "^7.1.1",
    "playwright": "^1.60.0",
    "rollup": "^4.0.0",
    "rollup-plugin-string": "^3.0.0",
    "serve": "^14.2.6"
  }
}
